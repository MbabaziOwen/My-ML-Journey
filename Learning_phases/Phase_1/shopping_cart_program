foods = []
prices = []
total  = 0

while True:
    food = input("enter a food to buy, (Press Q to quit):")
    if  food.lower() =="q":
            break
    else:
          price = float(input(f"enter the price of  {food}: Shs. "))
          foods.append(food)
          prices.append(price)

print("-----Your cart-----")
for food, price in zip(foods, prices):
      print(f"{food}:  Shs. {price}")


total = sum(prices)

print(f"your total is :Shs. {total} ")